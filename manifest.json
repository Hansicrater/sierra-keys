{
  "manifest_version": 3,
  "name": "Sierra keys",
  "version": "0.3.5",
  "description": "Rebindable keyboard shortcuts for Sierra Interactive",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*.sierrainteractivedev.com/*",
        "https://www.sierrainteractive.com/*",
        "https://sierrainteractive.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
